{
  "name": "wwcp-node-frontend",
  "version": "0.1.0",
  "description": "What the web interface of every WWCP node shares: TypeScript and SCSS that each kind of node bundles into its own, imported as @node/... through a webpack alias.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import ./test/resolve.ts --test \"src/**/*.test.ts\" \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "lit-html": "3.3.3",
    "typescript": "^6.0.3"
  }
}
